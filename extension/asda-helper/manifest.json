{
  "manifest_version": 3,
  "name": "Weekwise Asda Helper",
  "version": "0.1.0",
  "description": "Guided Asda shopping helper for Weekwise Meal Planner shopping lists.",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": [
    "https://groceries.asda.com/*",
    "https://www.asda.com/groceries/*",
    "https://weekly-meal-planning-alpha.vercel.app/*",
    "https://*.vercel.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "build/background.js"
  },
  "action": {
    "default_title": "Weekwise Asda Helper",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://weekly-meal-planning-alpha.vercel.app/*",
        "https://*.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["build/app-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://groceries.asda.com/*", "https://www.asda.com/groceries/*"],
      "js": ["build/asda-content.js"],
      "css": ["asda-overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
